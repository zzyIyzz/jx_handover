# 江西片区智能交接班系统 V0.4.0 源码运行配置示例
# 复制为 .env 后按实际情况修改。正式 Windows 服务端请优先用服务端控制器填写，
# 控制器会把 Key 和访问口令加密保存在服务器本机，不写入此文件。

# desktop：仅本机 127.0.0.1；server：局域网 0.0.0.0。
# 两种模式端口都固定为 8765，不能通过环境变量更改。
JX_HANDOVER_MODE=desktop

# server 模式填写客户端实际访问的服务器固定 IP 或内网 DNS 名称。
JX_PUBLIC_HOST=

# 可选数据目录。活数据库必须位于运行服务的电脑本地磁盘，不能放在 NAS。
JX_HANDOVER_DATA_DIR=

# 可选：只接收程序已经完整复制并通过 SHA256 校验的数据库备份。
# 示例：\\192.168.14.52\江西片区检修中心\交接班系统\备份
JX_NAS_BACKUP_DIR=

# mock：只用本地确定性规则；qwen：使用 Qwen3.8-Flash，并在失败时自动回退。
AI_MODE=mock
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=
AI_STRUCTURED_MODE=json_schema
AI_TIMEOUT_SECONDS=60

# 局域网身份与审计。服务端模式默认要求选择姓名；访问口令可留空。
JX_AUTH_REQUIRED=0
JX_ACCESS_CODE=
JX_ADMIN_NAMES=
JX_SESSION_TTL_HOURS=168

# Word 模板（通常无需修改）
# WORD_TEMPLATE=backend/app/templates/word/handover_v1.docx

# V0.3 桌面版兼容字段，可留空。
CLOUD_PUBLISH_DIR=
