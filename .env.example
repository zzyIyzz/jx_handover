# 江西片区智能交接班系统 环境配置示例
# 复制为 .env 后按实际情况修改

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# 数据目录（相对项目根目录，可改为绝对路径）
# SQLite 活数据库绝不能放到云盘同步目录

# Word 模板
# WORD_TEMPLATE=backend/app/templates/word/handover_v1.docx

# 正式发布目录（现有云盘同步目录，可留空表示只输出到 runtime/generated）
CLOUD_PUBLISH_DIR=

# AI 配置：mock=本地模拟（不调用外部接口）；qwen=真实 Qwen API
AI_MODE=mock
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
AI_STRUCTURED_MODE=json_schema
