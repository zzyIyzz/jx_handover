# 江西片区智能交接班系统 V0.5.3 源码运行配置示例
# 复制为 .env 后按实际情况修改。正式 Windows 服务端请优先用服务端控制器填写，
# Windows 控制器会把 Key 和旧版共享访问口令加密保存在服务器本机，不写入此文件。

# desktop：仅本机；server：Windows 局域网；cloud：Docker + HTTPS 反向代理。
# 应用内部保持 8765；cloud 模式由宝塔在公网 HTTPS 1215 反向代理。
JX_HANDOVER_MODE=desktop

# server 模式填写客户端实际访问的服务器固定 IP 或内网 DNS 名称。
JX_PUBLIC_HOST=

# cloud 模式的完整 HTTPS 地址必须包含 :1215；内部 8765 只发布到 ECS 本机。
JX_PUBLIC_URL=
JX_TRUSTED_HOSTS=
JX_CLOUD_ACCESS_SCOPE=
JX_COOKIE_SECURE=0

# 数据目录：账号信息与交接班记录全部保存在这里，必须在运行服务的电脑本地磁盘，
# 不能放在 NAS。留空时使用程序默认目录（源码运行为仓库内 runtime\，
# Windows 服务端为 ProgramData\JXHandoverServer\data，云端为容器内固定目录）。
# 正式部署建议显式固定，避免更换运行方式后指向空目录，看上去像“数据全丢”。
# 随时可以查看当前生效位置：python backend/scripts/data_location.py
JX_HANDOVER_DATA_DIR=
# 当前数据目录为空库时，是否自动从旧版 runtime-server 等目录把数据复制过来。
# 只复制、不删除、不移动；存在多个候选目录时不会自动选择，需要人工指定。
JX_DATA_ROOT_AUTOFIND=1

# 可选：只接收程序已经完整复制并通过 ZIP、SHA256、SQLite 校验的完整业务备份。
# 示例：\\192.168.14.52\江西片区检修中心\交接班系统\备份
JX_NAS_BACKUP_DIR=

# auto：填写了 QWEN_API_KEY 就用 Qwen3.8-Flash 智能整理工作日志，失败时自动回退；
#       没填 Key 时自动使用本地确定性规则，导入照常可用。
# mock：只用本地确定性规则；qwen：强制使用云端 AI（缺 Key 时导入会提示未配置）。
AI_MODE=auto
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=
AI_STRUCTURED_MODE=json_schema
AI_TIMEOUT_SECONDS=60

# 身份与审计。cloud 模式使用“姓名账号 + 个人密码”；首次登录必须修改初始密码。
# desktop/server 默认仍兼容旧的“选择姓名 + 共享访问口令”方式。
JX_AUTH_REQUIRED=0
JX_ACCOUNT_LOGIN_ENABLED=0
JX_INITIAL_ACCOUNT_PASSWORD=aaaa0000*
JX_ACCESS_CODE=
JX_SESSION_TTL_HOURS=168
JX_SESSION_SECRET=
JX_LOGIN_MAX_FAILURES=5
JX_LOGIN_NETWORK_MAX_FAILURES=30
JX_LOGIN_WINDOW_SECONDS=600
JX_LOGIN_BLOCK_SECONDS=900
# 管理员名单（逗号分隔）。管理员权限保存在数据库里，此处填写的姓名在每次启动时
# 都会被提升为管理员；留空则完全由管理页“人员账号”里的开关决定。
# 一个管理员都没有时，管理页、备份与恢复入口会整体消失，因此启动会按
# JX_DEFAULT_ADMIN_NAMES 兜底提升，并在日志中告警。
JX_ADMIN_NAMES=
# 兜底管理员姓名，仅在“数据库和环境变量都没有任何管理员”时生效一次。
# 填写为空值可关闭兜底（云端模式必须显式配置 JX_ADMIN_NAMES，不使用兜底）。
JX_DEFAULT_ADMIN_NAMES=刘学森
# 管理页不可用时，在服务器本机恢复管理员权限：
#   python backend/scripts/manage_admin.py --list
#   python backend/scripts/manage_admin.py --grant 姓名

# Word 模板（通常无需修改）
# WORD_TEMPLATE=backend/app/templates/word/handover_v1.docx

# V0.3 桌面版兼容字段，可留空。
CLOUD_PUBLISH_DIR=
