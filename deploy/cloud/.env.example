# 复制为 deploy/cloud/.env 后再填写。这个真实文件含口令和 Key，禁止提交 Git。

# ECS 本地数据盘目录。可以自定义，但必须是 ECS 本地 ESSD，不能是 OSS/NAS/Fuse 挂载。
JX_HOST_DATA_DIR=/www/jx-handover/data

JX_HANDOVER_MODE=cloud
JX_PUBLIC_URL=https://handover.example.com:1215
JX_TRUSTED_HOSTS=handover.example.com,127.0.0.1,localhost
JX_CLOUD_ACCESS_SCOPE=private

# 云端启动会强制检查这些安全项。访问口令至少 12 字符；会话密钥至少 32 字符。
JX_AUTH_REQUIRED=1
JX_COOKIE_SECURE=1
JX_ACCESS_CODE=请替换为至少12位的随机访问口令
JX_SESSION_SECRET=请替换为至少32位且不可提交Git的随机会话密钥
JX_ADMIN_NAMES=请填写实际管理员姓名
JX_SESSION_TTL_HOURS=12
JX_LOGIN_MAX_FAILURES=5
JX_LOGIN_NETWORK_MAX_FAILURES=30
JX_LOGIN_WINDOW_SECONDS=600
JX_LOGIN_BLOCK_SECONDS=900

# Qwen3.8-Flash：Key 只写在服务器的这个 .env 文件，不进入浏览器、镜像或 Git。
AI_MODE=qwen
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=请填写你自己的DashScope_API_Key
AI_STRUCTURED_MODE=json_schema
AI_TIMEOUT_SECONDS=60

# 云端异地备份由宿主机 ossutil + ECS RAM 角色完成，不把 AccessKey 写进这里。
JX_NAS_BACKUP_DIR=
CLOUD_PUBLISH_DIR=
