# 复制为 deploy/cloud/.env 后再填写。这个真实文件含口令和 Key，禁止提交 Git。

# ECS 本地数据盘目录。可以自定义，但必须是 ECS 本地 ESSD，不能是 OSS/NAS/Fuse 挂载。
JX_HOST_DATA_DIR=/www/jx-handover/data

# 不要在这里写 JX_HANDOVER_DATA_DIR：docker-compose 已把容器内数据根固定为
# /var/lib/jx-handover，并把它绑定到上面的宿主机目录。在这里填宿主机路径会让
# 容器内指向一个空目录，看上去就像“数据全丢”。
# 确认当前生效位置：docker compose exec -T app python -m scripts.data_location

# 版本号统一由仓库根 VERSION 文件提供。若以前手工写过 JX_APP_VERSION，请删除该行，
# 否则页面会继续显示过期版本。

JX_HANDOVER_MODE=cloud
JX_PUBLIC_URL=https://handover.example.com:1215
JX_TRUSTED_HOSTS=handover.example.com,127.0.0.1,localhost
JX_CLOUD_ACCESS_SCOPE=private

# 云端使用一人一账号：账号就是人员姓名，首次密码固定为 aaaa0000*，
# 登录后必须立即设置至少 12 字符的个人密码。数据库只保存 Argon2id 哈希。
# 会话密钥至少 32 字符，必须随机生成；不要把真实 .env 提交 Git。
JX_AUTH_REQUIRED=1
JX_COOKIE_SECURE=1
JX_ACCOUNT_LOGIN_ENABLED=1
JX_INITIAL_ACCOUNT_PASSWORD=aaaa0000*
JX_ACCESS_CODE=
JX_SESSION_SECRET=请替换为至少32位且不可提交Git的随机会话密钥
# 必填。云端公网入口必须显式指定管理员，不使用本地部署的兜底名单；
# 姓名必须与启用人员完全一致。管理员权限同时持久化在数据库 staff.is_admin 中，
# 因此下次部署即使漏填这里，已设置的管理员也不会被降权。
JX_ADMIN_NAMES=周智源,刘学森
# 系统管理员固定为周智源与刘学森两人（运维负责人 + 片区值班管理员）。
# 兜底名单与上面保持一致：即使数据库被清空重建，
# 管理员权限也只会落到这两人头上；只填一人会在重启后回收另一人的权限。
JX_DEFAULT_ADMIN_NAMES=周智源,刘学森
JX_SESSION_TTL_HOURS=12
JX_LOGIN_MAX_FAILURES=5
JX_LOGIN_NETWORK_MAX_FAILURES=30
JX_LOGIN_WINDOW_SECONDS=600
JX_LOGIN_BLOCK_SECONDS=900

# Qwen3.8-Flash：Key 只写在服务器的这个 .env 文件，不进入浏览器、镜像或 Git。
# auto：填了 Key 就用云端模型，没填就回落本地确定性规则，导入预览如实显示“未启用”。
# 写 qwen 而缺 Key 会让每次导入都去试连云端再回退，比 auto 更慢也更嘈杂。
AI_MODE=auto
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=请填写你自己的DashScope_API_Key
AI_STRUCTURED_MODE=json_schema
AI_TIMEOUT_SECONDS=60

# 云端异地备份由宿主机 ossutil + ECS RAM 角色完成，不把 AccessKey 写进这里。
JX_NAS_BACKUP_DIR=
CLOUD_PUBLISH_DIR=
