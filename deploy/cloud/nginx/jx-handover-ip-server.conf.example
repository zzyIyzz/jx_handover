# 无域名公网 IPv4 示例。使用前把 203.0.113.20 和 198.51.100.10 全部替换。
server {
    listen 80;
    server_name 203.0.113.20;

    # IP 短期证书约 6 天到期，必须长期保留 HTTP-01 自动续签入口。
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/203.0.113.20;
        allow all;
    }
    location / {
        return 301 https://$host:1215$request_uri;
    }
}

server {
    listen 1215 ssl http2;
    server_name 203.0.113.20;

    ssl_certificate /www/server/panel/vhost/cert/203.0.113.20/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/203.0.113.20/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    location / {
        # 示例：第一轮只允许部署管理员当前使用网络的公网出口 IPv4。
        allow 198.51.100.10;
        # allow 10.66.0.0/24;
        deny all;

        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        # 非标准 HTTPS 端口必须把端口一并传给后端，否则重定向会跳到默认 443。
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 1215;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
