# 复制为 oss-backup.env；这里只放路径，不放 AccessKey。
# Docker 部署填 compose 目录；systemd 部署留空，应用内置调度器已自动生成每日备份。
JX_CLOUD_COMPOSE_DIR=/www/jx-handover/app/deploy/cloud
# systemd 生产环境填实际数据目录，例如 /www/wwwroot/jx_handover/runtime-server
JX_HOST_DATA_DIR=/www/jx-handover/data
# 私有 Bucket，访问权限必须为私有；请填写自己的 Bucket。
JX_OSS_URI=oss://请替换为私有Bucket名称/jx-handover/production
JX_OSSUTIL_CONFIG=/www/jx-handover/config/ossutilconfig
JX_OSSUTIL_BIN=/usr/local/bin/ossutil
