# 无域名公网 IPv4 部署示例。复制为 .env 后，必须替换所有中文说明和 203.0.113.20。

# ECS 系统盘目录；以后增加 ESSD 时可迁移到 /data/jx-handover。
JX_HOST_DATA_DIR=/www/jx-handover/data

JX_HANDOVER_MODE=cloud
JX_PUBLIC_URL=https://203.0.113.20:1215
JX_TRUSTED_HOSTS=203.0.113.20,127.0.0.1,localhost
JX_CLOUD_ACCESS_SCOPE=private

JX_AUTH_REQUIRED=1
JX_COOKIE_SECURE=1
JX_ACCOUNT_LOGIN_ENABLED=1
JX_INITIAL_ACCOUNT_PASSWORD=aaaa0000*
JX_ACCESS_CODE=
JX_SESSION_SECRET=请替换为至少32位且不可提交Git的随机会话密钥
JX_ADMIN_NAMES=请填写实际管理员姓名
JX_SESSION_TTL_HOURS=12
JX_LOGIN_MAX_FAILURES=5
JX_LOGIN_NETWORK_MAX_FAILURES=30
JX_LOGIN_WINDOW_SECONDS=600
JX_LOGIN_BLOCK_SECONDS=900

AI_MODE=qwen
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=请填写你自己的DashScope_API_Key
AI_STRUCTURED_MODE=json_schema
AI_TIMEOUT_SECONDS=60

JX_NAS_BACKUP_DIR=
CLOUD_PUBLISH_DIR=
